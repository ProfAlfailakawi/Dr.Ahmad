# ═══════════════════════════════════════════════════
#  انسخ هذا الملف إلى  .env  ثم املأ ما تحتاجه.
#  الموقع العام يعمل بلا أسرار؛ ميزات AI والصوت المجدول تحتاج مفاتيح الخادم أدناه.
# ═══════════════════════════════════════════════════

# ─── الصوت الطبيعي للمقالات ───────────────────────
# فحص بلا شبكة ولا كتابة: npm run audio:dry-run
# التوليد التلقائي للأصل + مقالات Firestore: npm run audio
# Azure: ٥٠٠ ألف حرف مجاناً شهرياً. مقالاتك ١٥٠ ألف حرف.
# أنشئ مورد Speech من portal.azure.com ثم انسخ المفتاح والمنطقة.
TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=uaenorth
# أصوات كويتية:  ar-KW-FahedNeural (رجل)  ·  ar-KW-NouraNeural (امرأة)
TTS_VOICE=ar-KW-FahedNeural

# بديل — ElevenLabs (أطبع صوت، لكن بالفصحى لا اللهجة الكويتية)
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# ─── النطاق الرسمي الوحيد ───────────────────────
VITE_SITE_URL=https://dr-alfailakawi.com
CANONICAL_HOST=dr-alfailakawi.com

# ─── Firebase للبيانات والتسجيل: drahmad-8e9e2 ─────
# يبقى authDomain تابعاً لمشروع البيانات؛ أضف dr-alfailakawi.com إلى Authorized Domains من لوحة Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=drahmad-8e9e2.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=drahmad-8e9e2
VITE_FIREBASE_STORAGE_BUCKET=drahmad-8e9e2.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=338353161227
VITE_FIREBASE_APP_ID=1:338353161227:web:07758261d630b04211730e
VITE_FIREBASE_APPCHECK_SITE_KEY=

# ─── الخادم والمهام المجدولة (لا تبدأ بـ VITE_) ─────
# يجب أن يطابقا مشروع البيانات أعلاه، لا مشروع Firebase Hosting.
FIREBASE_PROJECT_ID=drahmad-8e9e2
FIREBASE_STORAGE_BUCKET=drahmad-8e9e2.firebasestorage.app
# ملف حساب خدمة خارج Git؛ يحتاج Firestore وStorage للمهمة الصوتية.
FIREBASE_SERVICE_ACCOUNT=./sa.json

# نقطتا POST /api/ai/article-suggestion و /api/ai/content-suggestion — المفتاح يبقى في الخادم فقط.
# الثانية تقترح أيضاً عناوين الإعلام ووصف الكتب والأبحاث؛ oEmbed يُجرّب أولاً للفيديو.
GEMINI_API_KEY=
# إن أنشأت المفتاح في Google AI Studio باسم GOOGLE_API_KEY فقط فالنظام يقبله أيضاً.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=20000
OEMBED_TIMEOUT_MS=5000
AI_RATE_LIMIT_PER_MINUTE=12

# ─── استوديو المقال والسوشيال المتقدم ─────────────
# يحلل أرشيف المقالات، يقفل العدد بين 350 و450 كلمة حرفياً،
# ويفحص عدم تكرار الزاوية قبل السماح بالنشر.
EDITORIAL_GEMINI_MODEL=gemini-2.5-flash
EDITORIAL_AI_TIMEOUT_MS=45000
# أحداث الساعة تُقرأ من خلاصات المصادر الأكاديمية المسموحة وتُخزّن 10 دقائق فقط.
LIVE_CONTEXT_CACHE_MS=600000

# ─── البودكاست العربي الصارم ──────────────────────
# الزوج الافتراضي قابل للتبديل بلا تعديل الكود. نورة أبطأ قليلاً حتى يظهر دفء خامتها.
PODCAST_AR_MALE=ar-KW-FahedNeural
PODCAST_AR_FEMALE=ar-KW-NouraNeural
PODCAST_AR_MALE_NAME=فهد
PODCAST_AR_FEMALE_NAME=نورة
PODCAST_AR_MALE_RATE_OFFSET=-1
PODCAST_AR_FEMALE_RATE_OFFSET=-3
# نماذج مثبتة للحوار والتحليل والحكم؛ تغييرها يغيّر بصمة المنظومة ويعيد الفحص.
PODCAST_DIALOGUE_MODEL=gemini-2.5-flash
PODCAST_ANALYSIS_MODEL=gemini-2.5-flash
PODCAST_JUDGE_MODEL=gemini-2.5-flash
# مهمة الليل تعالج حلقة عربية واحدة فقط في كل تشغيل لتضبط التكلفة.
PODCAST_NIGHTLY_LIMIT=1
# قبل فتح النشر العام لأي نسخة جديدة من المحرك: ثلاث حلقات متنوعة في منطقة معزولة.
PODCAST_REQUIRE_PILOT_GATE=true
PODCAST_PILOT_COUNT=3
# إذا نجحت الحلقات الثلاث كلها، تُرقّى دفعة واحدة. أي فشل يعيد الجميع إلى Last-Known-Good.
PODCAST_AUTO_PROMOTE_PILOT=true
# عدد نسخ الرجوع المحلية المحفوظة لكل حلقة.
PODCAST_RELEASE_RETENTION=5
# فحص اختياري بعد الاستبدال المحلي. مثال: npm run build && node scripts/verify-podcast-release.mjs --no-network
PODCAST_POST_PUBLISH_CHECK=
PODCAST_POST_PUBLISH_TIMEOUT_MS=180000
# اختيارية: تثبيت ثلاث مقالات بعينها بدلاً من الاختيار الآلي المتنوع.
PODCAST_PILOT_SLUGS=
AUTO_GENERATE_ENGLISH=false
# اختيارية؛ السكربت يكتشف Homebrew تلقائياً حتى داخل launchd.
FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
FFPROBE_BIN=/opt/homebrew/bin/ffprobe

# ─── التقرير الشهري ───────────────────────────────
# جدْول `npm run report:monthly` يومياً؛ يكتب تقرير الشهر السابق مرة واحدة
# إلى admin_reports/YYYY-MM ويتجاوز التشغيلات اللاحقة تلقائياً.
# على macOS يظهر إشعار محلي افتراضياً؛ عطّله فقط عند الحاجة.
REPORT_LOCAL_NOTIFICATION=true
# المعاينة تقرأ Firestore ولا تكتب ولا ترسل إشعاراً:
#   npm run report:monthly:dry-run
# إشعار خارجي اختياري (HTTPS webhook فقط). لا بريد ولا أسرار في الحمولة.
REPORT_WEBHOOK_URL=

# ملاحظة أمان:
# حساب لوحة التحكم يحتاج Firebase custom claim:
#   admin: true

# ─── التحليلات (بلا كوكيز) ────────────────────────
VITE_PLAUSIBLE_DOMAIN=dr-alfailakawi.com
# رموز إثبات الملكية من Google Search Console وBing Webmaster Tools.
# تُنسخ من الحسابين بعد إضافة النطاق؛ تركها فارغة لا يضيف وسماً ناقصاً.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# ─── بوابة الإطلاق النهائية للبودكاست ──────────────
# لا يصل أي حوار إلى R2 أو podcast.xml إذا كانت الدرجة أقل من هذا الحد.
PODCAST_RELEASE_MIN_SCORE=94
# تفعيل فحص روابط enclosure العامة وHTTP Range بعد البناء.
PODCAST_VERIFY_REMOTE_AUDIO=true

# ─── بدء توليد البودكاست فوراً من لوحة التحكم ──────
# يبقى الرمز في خادم dr-api فقط ولا يصل إلى المتصفح.
# Fine-grained GitHub token للمستودع ProfAlfailakawi/Dr.Ahmad بصلاحية Actions: Read and write.
GITHUB_WORKFLOW_TOKEN=
PODCAST_GITHUB_REPOSITORY=ProfAlfailakawi/Dr.Ahmad
PODCAST_GITHUB_WORKFLOW=podcast-pilot-release.yml
PODCAST_GITHUB_REF=main

# حساب المالك الذي يدخل لوحة التحكم حتى قبل مزامنة custom claim.
# يجب أن يطابق البريد المسموح به أيضاً في firestore.rules وstorage.rules.
VITE_OWNER_EMAILS=ah_f@hotmail.com

# ─── جسر واتساب المركزي ───────────────────────────
# القيمة نفسها توجد في /etc/whatsapp-bridge.env على VM. لا تستخدم VITE_؛
# السر لا يصل إلى المتصفح، ولوحة الإدارة تدخل بتوثيق Firebase فقط.
WHATSAPP_BRIDGE_SECRET=
WHATSAPP_SITE_URL=https://dr-alfailakawi.com
WHATSAPP_MANUAL_TAKEOVER_MINUTES=30

# ─── المساعد المحلي القديم (مسار رجوع فقط) ─────────
# يعمل طوال اليوم بلا نافذة صمت وبلا سقف لعدد الردود.
# لا يبدأ إلا بعد «موقع د. أحمد» أو «موقع د. الفيلكاوي»، ثم تبقى الجلسة حيّة
# حتى يردّ الدكتور بيده. بعد التدخل اليدوي لا تعود إلا بجملة الإيقاظ من جديد.
WHATSAPP_AGENT_ENABLED=true
WHATSAPP_SEND_ENABLED=false
WHATSAPP_AUTO_REPLY_ENABLED=false
WHATSAPP_PRIVATE_AUTO_REPLY_ENABLED=false
WHATSAPP_PERSONAL_NUMBER_MODE=true
WHATSAPP_TIME_ZONE=Asia/Kuwait
# لا تُستخدم WHATSAPP_QUIET_FROM / WHATSAPP_QUIET_UNTIL / WHATSAPP_HOURLY_REPLY_CAP
# لا متغير لمدة الجلسة ولا سقف للردود؛ جملة الإيقاظ تفتحها وتدخّل الدكتور يغلقها.

# ─── Cloudflare Workers AI — توليد صور الاستوديو (خادم dr-api فقط) ───
# لا تستخدم VITE_ هنا؛ هذه القيم أسرار خلفية ولا يجوز أن تدخل حزمة المتصفح.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
CLOUDFLARE_IMAGE_STEPS=8
CLOUDFLARE_IMAGE_TIMEOUT_MS=45000
CLOUDFLARE_VISION_CRITIC_MODEL=@cf/moondream/moondream3.1-9B-A2B
CLOUDFLARE_VISION_CRITIC_TIMEOUT_MS=24000
STUDIO_IMAGE_REQUIRE_VISION_CRITIC=true

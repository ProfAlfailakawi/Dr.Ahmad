# عنوان الخادم الرئيسي، لا عنوان لوحة المتصفح.
WHATSAPP_MAIN_SERVER_URL=https://dr-alfailakawi.com

# أنشئ قيمة طويلة عشوائية واحدة وضعها هنا وفي الخادم الرئيسي.
WHATSAPP_BRIDGE_SECRET=replace-with-at-least-32-random-bytes

# رقم الدكتور/الموظف الذي يستقبل تنبيه التصعيد. يقبل 965XXXXXXXX أو JID كامل.
WHATSAPP_OWNER_CHAT_ID=965XXXXXXXX

# جلسة LocalAuth الدائمة. لا تضعها داخل مجلد الكود.
WHATSAPP_SESSION_DIR=/var/lib/whatsapp-bridge/session
WHATSAPP_CLIENT_ID=primary

# اختياري إذا كان Chrome مثبتًا بمسار مخصص.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

WHATSAPP_BRIDGE_HEALTH_PORT=34322
WHATSAPP_BRIDGE_DEVICE_NAME=dr-alfailakawi-bridge
WHATSAPP_COMMAND_POLL_MS=5000
WHATSAPP_HEARTBEAT_MS=30000

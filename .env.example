# ═══════════════════════════════════════════════════
#  انسخ هذا الملف إلى  .env  ثم املأ ما تحتاجه.
#  كل شيء اختياري — الموقع يعمل بدونه كاملاً.
# ═══════════════════════════════════════════════════

# ─── الصوت الطبيعي للمقالات ───────────────────────
# بعد الملء:  npm run audio
# Azure: ٥٠٠ ألف حرف مجاناً شهرياً. مقالاتك ١٥٠ ألف حرف.
# أنشئ مورد Speech من portal.azure.com ثم انسخ المفتاح والمنطقة.
TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=uaenorth
# أصوات كويتية:  ar-KW-FahedNeural (رجل)  ·  ar-KW-NouraNeural (امرأة)
TTS_VOICE=ar-KW-FahedNeural

# بديل — ElevenLabs (أطبع صوت، لكن بالفصحى لا اللهجة الكويتية)
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# ─── Firebase (نموذج التواصل + النشرة) ────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APPCHECK_SITE_KEY=

# ملاحظة أمان:
# حساب لوحة التحكم يحتاج Firebase custom claim:
#   admin: true

# ─── التحليلات (بلا كوكيز) ────────────────────────
VITE_PLAUSIBLE_DOMAIN=
